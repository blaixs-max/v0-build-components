rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanicilar - herkese okuma, sadece kendi verisini yazma
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ilanlar - herkes okuyabilir, giris yapanlar olusturabilir, sahip guncelleyebilir
    match /listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.sellerId;
    }

    // Teklifler - giris yapanlar olusturabilir, taraflar okuyabilir/guncelleyebilir
    match /offers/{offerId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.offererId
          || request.auth.uid == resource.data.sellerId);
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.offererId
          || request.auth.uid == resource.data.sellerId);
    }
  }
}
